{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnterpriseERPLogisticsImportFormat",
  "description": "18-column fixed layout required by Enterprise Logistics ERP batch ingestion engine",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "TRANSACTION_TYPE",
        "DISPATCH_ID",
        "DRIVER_CODE",
        "VEHICLE_IDENTIFIER",
        "ROUTE_DATE",
        "CUSTOMER_ACCOUNT_ID",
        "SPECIAL_INSTRUCTIONS",
        "COMMODITY_SKU_01",
        "COMMODITY_SKU_02",
        "COMMODITY_SKU_03",
        "COMMODITY_SKU_04",
        "COMMODITY_SKU_05",
        "RETURNABLE_CONTAINERS",
        "SETTLEMENT_TERMS",
        "DISPATCH_PRIORITY",
        "AUDIT_TIMESTAMP",
        "STATUS_CODE",
        "INTERNAL_REMARKS"
      ]
    },
    "delimiters": {
      "column_delimiter": ";",
      "date_format": "DD/MM/YYYY",
      "encoding": "windows-1250"
    }
  }
}